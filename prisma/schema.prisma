generator client {
  provider = "prisma-client-js"
}

/**
 * datasource db {
 * provider = "postgresql"
 * url      = env("DATABASE_URL")
 * }
 */

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id           String  @id @default(uuid())
  name         String
  description  String?
  global       Boolean @default(false)
  category     String
  subcategory  String
  type         String
  brand        String
  model        String
  year         Int
  pricePerDay  Float
  availability Boolean @default(true)
  features     Json
  location     Json
  images       Json
  seats        Int
  starCount    Int     @default(0)
  gearBox      String
  fuel         String
  doors        Int
  distance     String
  ratings Rating[]
}

model Rating {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  stars     Int
}
